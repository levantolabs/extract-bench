# Copy to .env (never commit it) or export these in your shell. Only needed for live runs (`run read --live`).
EXB_LIVE=0                    # set to 1 to allow live API calls
EXB_CAP_USD=                  # required for live runs: $ ceiling across all runs (checked against runs/_ledger.jsonl)

# Cloudflare Workers AI (Clairic)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Levanto Sage 2
SAGE_API_KEY=
SAGE2_BASE_URL=
SAGE2_PRICE_IN_PER_TOK=       # optional, $ per input token; cost is recorded as null when unset
SAGE2_PRICE_OUT_PER_TOK=

# OpenRouter (any LLM/VLM arm: or:<model>:text|image|image+text)
OPENROUTER_API_KEY=

# Concurrency
EXB_SAGE_CONC=2
EXB_OR_CONC=4
